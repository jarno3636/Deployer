{
  "name": "scanarc-router-deployer",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run compile:indexio-pay-v2 && npm run compile:indexio-v34 && npm run compile:indexio-v342-adaptive && npm run check:indexio-v342-build && npm run compile:indexio-v338 && npm run compile:indexio-pay",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "prebuild": "npm run check:indexio-v334 && npm run check:indexio-v34 && npm run check:indexio-v342-patch && npm run compile:indexio-v34 && npm run compile:indexio-v342-adaptive && npm run check:indexio-v342-build && npm run compile:scanarc && npm run compile:indexio && npm run compile:indexio-v25 && npm run compile:indexio-v3 && npm run compile:indexio-v338 && npm run compile:indexio-adaptive-buy && npm run compile:indexio-pay && npm run compile:indexio-pay-v2",
    "compile:scanarc": "node scripts/compile-scanarc-router.mjs",
    "compile:bridge": "node scripts/compile-scanarc-bridge.mjs",
    "compile:indexio": "node scripts/compile-indexio.mjs && node scripts/compile-indexio-adapter.mjs",
    "compile:indexio-adapter": "node scripts/compile-indexio-adapter.mjs",
    "compile:indexio-v25": "node scripts/compile-indexio-v25.mjs",
    "check:indexio-v25": "node scripts/check-indexio-v25-security.mjs",
    "release:indexio-v25": "npm run check:indexio-v25 && npm run compile:indexio-v25 && npm run build",
    "test:indexio-v25": "forge test --match-path test/IndexioV25Regression.t.sol -vv",
    "compile:indexio-v3": "node scripts/compile-indexio-v3.mjs",
    "compile:indexio-v338": "node scripts/compile-indexio-v338.mjs",
    "check:indexio-v31": "node scripts/check-indexio-v31-security.mjs",
    "release:indexio-v31": "npm run check:indexio-v31 && npm run compile:indexio-v3 && npm run build",
    "check:indexio-v334": "node scripts/check-indexio-v334-security.mjs",
    "compile:indexio-adaptive-buy": "node scripts/compile-indexio-adaptive-buy.mjs",
    "compile:indexio-pay": "node scripts/compile-indexio-pay.mjs",
    "compile:indexio-v342-adaptive": "node scripts/compile-indexio-v342-adaptive.mjs",
    "check:indexio-v342-patch": "node scripts/check-indexio-v342-patch.mjs",
    "compile:indexio-v34": "node scripts/compile-indexio-v34.mjs",
    "check:indexio-v342-build": "node scripts/check-indexio-v342-build.mjs",
    "release:indexio-v342": "npm run build",
    "check:indexio-v34": "node scripts/check-indexio-v34.mjs",
    "compile:indexio-pay-v2": "node scripts/compile-indexio-pay-v2.mjs",
    "test:indexio-pay-v2": "forge test --match-path test/IndexioMultiAssetPayV2.t.sol -vv"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "next": "16.2.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "^2.38.0",
    "wagmi": "^2.18.2",
    "solc": "0.8.30",
    "@openzeppelin/contracts": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.3"
  }
}
